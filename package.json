{
  "name": "engineering-os",
  "private": true,
  "version": "0.1.0",
  "description": "Engineering operating system for AI-assisted development",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @amitmishrg/engineering-os",
    "dev": "npm run dev -w @amitmishrg/engineering-os",
    "test": "npm run test -w @amitmishrg/engineering-os",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  }
}
