{
  "name": "@amitmishrg/engineering-os",
  "version": "0.1.0",
  "description": "CLI for Engineering OS — bootstrap AI engineering workflows into any repo",
  "type": "module",
  "bin": {
    "engineering-os": "./dist/cli.js"
  },
  "files": [
    "dist",
    "core"
  ],
  "scripts": {
    "build": "tsc && npm run copy-core",
    "copy-core": "node scripts/copy-core.mjs",
    "dev": "tsx src/cli.ts",
    "test": "node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "puppeteer-core": "^25.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
