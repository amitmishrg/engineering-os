{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os.dev/schemas/bug-record.json",
  "title": "BugRecord",
  "description": "Schema for .ai/memory/bugs/*.md frontmatter (validated by engineering-os validate)",
  "type": "object",
  "required": [
    "id",
    "title",
    "branch",
    "owner",
    "created_at",
    "symptoms",
    "root_cause",
    "affected_files",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^BUG-[0-9]{4}-[0-9]{4,}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date" },
    "resolved_at": { "type": "string", "format": "date" },
    "release": { "type": "string" },
    "symptoms": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "root_cause": { "type": "string", "minLength": 1 },
    "affected_files": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  },
  "additionalProperties": true
}
