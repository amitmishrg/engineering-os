{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os.dev/schemas/performance-record.json",
  "title": "PerformanceRecord",
  "type": "object",
  "required": ["id", "title", "type", "branch", "owner", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^PERF-[0-9]{4}-[0-9]{4,}$" },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["memory-leak", "cpu", "gc", "render", "vitals", "mixed"]
    },
    "branch": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date" },
    "resolved_at": { "type": "string", "format": "date" },
    "release": { "type": "string" },
    "symptoms": { "type": "array", "items": { "type": "string" } },
    "root_cause": { "type": "string" },
    "affected_files": { "type": "array", "items": { "type": "string" } },
    "scenario": { "type": "string" },
    "pages": { "type": "array" },
    "reports": { "type": "object" },
    "metrics": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
  },
  "additionalProperties": true
}
