{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os.dev/schemas/pattern-record.json",
  "title": "PatternRecord",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": { "type": "string", "pattern": "^PAT-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
